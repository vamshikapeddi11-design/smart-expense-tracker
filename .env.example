# ==============================================================================
# Smart Expense Tracker — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env` to git.
#   cp .env.example .env
# ==============================================================================

# Postgres superuser for the local `db` container.
POSTGRES_USER=expensetracker

# Postgres password — pick something strong, e.g.:
#   openssl rand -base64 24
POSTGRES_PASSWORD=root

# Signing key for backend JWTs (HS256). Generate with:
#   openssl rand -base64 32
# Must be identical across backend restarts or issued tokens will be rejected.
JWT_SECRET=
